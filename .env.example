# Node environment
NODE_ENV=development
PORT=3030

# MongoDB
MONGO_URL=mongodb://127.0.0.1:27017/writeme

# Session (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
SESSION_SECRET=change-me-to-a-32-byte-random-string

# Google OAuth
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create "OAuth 2.0 Client ID" of type "Web application"
# 3. Add http://localhost:3030 to Authorized JavaScript origins
# 4. Paste the Client ID below
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
