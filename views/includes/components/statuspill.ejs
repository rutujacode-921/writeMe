<%
    const map = {
        OPEN: 'open',
        ASSIGNED: 'assigned',
        IN_PROGRESS: 'in_progress',
        DELIVERED: 'delivered',
        COMPLETED: 'completed',
        CANCELLED: 'cancelled',
        DISPUTED: 'disputed',
        DRAFT: 'cancelled',
    };
    const cls = map[status] || 'open';
%>
<span class="pill pill--<%= cls %>"><%= status %></span>
