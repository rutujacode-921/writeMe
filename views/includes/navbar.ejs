<nav class="topnav">
    <a href="/" class="topnav__brand">writeMe</a>
    <div class="topnav__spacer"></div>
    <% if (currentUser) { %>
        <% if (currentUser.onboardedAt) { %>
            <a href="/mytasks" class="hidden-mobile muted" style="font-size:14px;margin-right:12px">My Tasks</a>
            <a href="/chats" class="hidden-mobile muted" style="font-size:14px;margin-right:12px">Chats</a>
            <a href="/earnings" class="hidden-mobile muted" style="font-size:14px;margin-right:12px">Earnings</a>
        <% } %>
        <form action="/auth/logout" method="POST" style="margin:0">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <button type="submit" class="topnav__avatar" title="Sign out — <%= currentUser.name %>" style="border:none;cursor:pointer">
                <% if (currentUser.avatar) { %>
                    <img src="<%= currentUser.avatar %>" alt="<%= currentUser.name %>" />
                <% } else { %>
                    <%= (currentUser.name || "?").charAt(0).toUpperCase() %>
                <% } %>
            </button>
        </form>
    <% } else { %>
        <a href="/auth/login" class="btn btn--secondary btn--sm">Log in</a>
        <a href="/auth/signup" class="btn btn--primary btn--sm" style="margin-left:8px">Sign up</a>
    <% } %>
</nav>
