<% layout("/layouts/boilerplate") %>

<div class="row mt-4 justify-content-center">
    <div class="col-md-6 col-lg-5">
        <h3 class="mb-3 text-center">Sign Up for WriteMe</h3>
        <form action="/signup" method="POST" class="needs-validation">
            <div class="mb-3">
                <label for="username" class="form-label">Username</label>
                <input type="text" name="username" id="username" class="form-control" required>
            </div>
            <div class="mb-3">
                <label for="email" class="form-label">Email</label>
                <input type="email" name="email" id="email" class="form-control" required>
            </div>
            <div class="mb-3">
                <label for="college" class="form-label">College / Department</label>
                <input type="text" name="college" id="college" class="form-control" placeholder="e.g. CSE">
            </div>
            <div class="mb-3">
                <label for="password" class="form-label">Password</label>
                <input type="password" name="password" id="password" class="form-control" required>
            </div>
            <button class="btn btn-success w-100">Sign Up</button>
        </form>
    </div>
</div>