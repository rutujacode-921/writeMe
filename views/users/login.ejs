<% layout("/layouts/boilerplate") %>
<% const v = values || {}; %>

<div style="max-width:420px; margin:40px auto 0">
    <h1 style="font-size:24px; font-weight:800; margin:0 0 8px">Welcome back</h1>
    <p class="muted" style="margin:0 0 24px">New here? <a href="/auth/signup">Create an account</a></p>

    <% if (error) { %>
        <div style="background:rgba(231,76,60,0.1); color:var(--color-danger); padding:12px; border-radius:12px; margin-bottom:16px">
            <%= error %>
        </div>
    <% } %>

    <form method="POST" action="/auth/login">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

        <div class="form-group">
            <label class="form-label" for="username">Username</label>
            <input class="form-input" type="text" name="username" id="username"
                   value="<%= v.username || '' %>" required autofocus />
        </div>

        <div class="form-group">
            <label class="form-label" for="password">Password</label>
            <input class="form-input" type="password" name="password" id="password" required />
        </div>

        <button type="submit" class="btn btn--primary btn--block">Log in</button>
    </form>
</div>
