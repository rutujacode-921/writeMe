<% layout("/layouts/boilerplate") %>

<div style="padding: 48px 16px; text-align:center">
    <h1 style="font-size:36px; font-weight:800; margin:0 0 12px">
        Hand-written assignments, written by your campus.
    </h1>
    <p class="muted" style="font-size:16px; max-width:460px; margin:0 auto 32px">
        Post a record book, journal, or assignment. Another student on your campus
        picks it up, writes it, and hands it over in person. You pay cash. Done.
    </p>

    <div style="display:flex; gap:12px; justify-content:center; flex-wrap:wrap">
        <a href="/auth/signup" class="btn btn--primary">Create account</a>
        <a href="/auth/login" class="btn btn--secondary">Log in</a>
    </div>

    <div style="margin-top:48px; display:grid; grid-template-columns:1fr; gap:16px; max-width:460px; margin-left:auto; margin-right:auto">
        <div class="stat">
            <div class="stat__label">Step 1</div>
            <div style="font-weight:700">Post your task</div>
            <div class="muted" style="font-size:14px">Subject, pages, price in ₹, pickup point.</div>
        </div>
        <div class="stat">
            <div class="stat__label">Step 2</div>
            <div style="font-weight:700">A student accepts</div>
            <div class="muted" style="font-size:14px">You chat, agree on timing & spot.</div>
        </div>
        <div class="stat">
            <div class="stat__label">Step 3</div>
            <div style="font-weight:700">Meet, inspect, pay</div>
            <div class="muted" style="font-size:14px">On campus. Cash. Both of you rate each other.</div>
        </div>
    </div>
</div>
