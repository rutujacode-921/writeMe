<% layout("/layouts/boilerplate") %>

<div class="container mt-4" style="max-width: 600px;">
    <h3 class="mb-3">Chat for Task: <%= task.subject %></h3>

    <!-- Chat Box Container -->
    <div class="border rounded p-3 mb-3 bg-light" style="height: 400px; overflow-y: scroll;">
        <% if (messages.length === 0) { %>
            <p class="text-muted text-center mt-5">No messages yet. Start the conversation below!</p>
        <% } else { %>
            <% for(let msg of messages) { %>
                <div class="mb-2 p-2 rounded bg-white shadow-sm">
                    <!-- Displays the exact username entered during signup -->
                    <strong class="text-primary"><%= msg.sender ? msg.sender.username : "User" %>:</strong>                    <span><%= msg.text %></span>
                    <div class="text-muted" style="font-size: 0.75rem; text-align: right;">
                        <%= new Date(msg.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %>
                    </div>
                </div>
            <% } %>
        <% } %>
    </div>

    <!-- Message Input Form -->
    <form action="/messages/<%= task._id %>" method="POST" class="d-flex gap-2">
        <input type="text" name="content" class="form-control" placeholder="Type a message..." required>
            <button type="submit" class="btn btn-primary">Send</button>
    </form>
</div>