<% layout("/layouts/boilerplate") %>

<div class="container mt-4">
    <h2>My Total Earnings</h2>
    
    <!-- Earnings Summary Card -->
    <div class="card text-bg-dark mb-4 shadow-sm" style="max-width: 20rem;">
        <div class="card-body">
            <h5 class="card-title">Total Earned</h5>
            <h3 class="card-text">&#8377;<%= totalEarnings %></h3>
        </div>
    </div>

    <h4 class="mb-3">Completed / Accepted Tasks</h4>

    <% if (acceptedTasks.length === 0) { %>
        <p class="text-muted">You haven't accepted any tasks yet.</p>
    <% } else { %>
        <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 g-3">
            <% for(let task of acceptedTasks) { %>
                <div class="card col" style="margin: 0.5rem;">
                    <div class="card-body">
                        <% if (task.image) { %>
                            <img src="<%= task.image %>" class="card-img-top mb-2" alt="Task Image" style="height: 150px; width: 100%; object-fit: cover;">
                        <% } %>
                        <h5 class="card-title"><%= task.subject %></h5>
                        <p class="card-text">
                            <b>Price : </b>&#8377;<%= task.price %><br>
                            <b>Deadline : </b><%= task.deadline %><br>
                            <b>Location : </b><%= task.location %>
                        </p>
                        <button class="btn btn-success w-100" disabled>Completed</button>
                    </div>
                </div>
            <% } %>
        </div>
    <% } %>
</div>