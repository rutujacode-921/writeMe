<% layout("/layouts/boilerplate") %>

<h1 style="font-size:22px; font-weight:700; margin:0 0 16px">Earnings</h1>

<div class="stat" style="margin-bottom:16px">
    <div class="stat__label">Total earned</div>
    <div class="stat__big">₹<%= totalEarned.toLocaleString('en-IN') %></div>
    <div class="muted" style="font-size:13px">across <%= completed.length %> completed task<%= completed.length === 1 ? '' : 's' %></div>
</div>

<div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:24px">
    <div class="stat">
        <div class="stat__label">This month</div>
        <div style="font-size:22px; font-weight:700; color:var(--color-money)">₹<%= monthEarned.toLocaleString('en-IN') %></div>
        <div class="muted" style="font-size:12px"><%= monthCount %> task<%= monthCount === 1 ? '' : 's' %></div>
    </div>
    <div class="stat">
        <div class="stat__label">Pending</div>
        <div style="font-size:22px; font-weight:700; color:var(--color-warning)">₹<%= pendingTotal.toLocaleString('en-IN') %></div>
        <div class="muted" style="font-size:12px">awaiting confirmation</div>
    </div>
</div>

<h2 style="font-size:15px; text-transform:uppercase; letter-spacing:0.04em; color:var(--color-text-muted); margin:24px 0 12px">
    Recent completed
</h2>
<% if (!completed.length) { %>
    <div class="muted" style="padding:16px 0">No completed tasks yet. Accept one from the feed to start.</div>
<% } else { %>
    <% completed.forEach(function(task) { %>
        <a href="/tasks/<%= task._id %>" class="taskcard">
            <div class="row row--between">
                <div style="font-weight:700"><%= task.subject %></div>
                <span class="badge badge--money">+₹<%= task.price %></span>
            </div>
            <div class="muted" style="font-size:13px; margin-top:4px">
                <%= task.completedAt ? new Date(task.completedAt).toLocaleDateString('en-IN', { day:'numeric', month:'short' }) : '—' %>
                · <%= task.pickupPoint %>
            </div>
        </a>
    <% }); %>
<% } %>

<div class="muted" style="font-size:12px; text-align:center; padding:24px 0 48px">
    writeMe does not process payments. All ₹ is exchanged in person.
</div>
