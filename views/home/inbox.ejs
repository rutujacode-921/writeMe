<% layout("/layouts/boilerplate") %>

<div class="container mt-4" style="max-width: 700px;">
    <h3 class="mb-4">My Conversations</h3>
    
    <% if (tasks.length === 0) { %>
        <p class="text-muted">You haven't started any chats yet. Browse tasks and click "Message" to start a conversation!</p>
    <% } else { %>
        <div class="list-group">
            <% for(let task of tasks) { %>
                <a href="/messages/<%= task._id %>" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="mb-1"><%= task.subject %></h5>
                        <p class="mb-1 text-muted small">Location: <%= task.location %> | Price: ₹<%= task.price %></p>
                    </div>
                    <span class="btn btn-sm btn-outline-primary">Open Chat</span>
                </a>
            <% } %>
        </div>
    <% } %>
</div>