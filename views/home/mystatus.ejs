<% layout("/layouts/boilerplate") %>

<h1 style="font-size:22px; font-weight:700; margin:0 0 16px">My tasks</h1>

<h2 style="font-size:15px; text-transform:uppercase; letter-spacing:0.04em; color:var(--color-text-muted); margin:16px 0 12px">
    I posted (<%= posted.length %>)
</h2>
<% if (!posted.length) { %>
    <div class="muted" style="padding:16px 0">Nothing posted yet. <a href="/tasks/new">Post your first task</a>.</div>
<% } else { %>
    <% posted.forEach(function(task) { %>
        <a href="/tasks/<%= task._id %>" class="taskcard">
            <div class="row row--between">
                <div style="font-weight:700"><%= task.subject %></div>
                <%- include("../includes/components/statuspill.ejs", { status: task.status }) %>
            </div>
            <div class="muted" style="font-size:13px; margin-top:4px">
                ₹<%= task.price %> · <%= task.pickupPoint %>
            </div>
        </a>
    <% }); %>
<% } %>

<h2 style="font-size:15px; text-transform:uppercase; letter-spacing:0.04em; color:var(--color-text-muted); margin:32px 0 12px">
    I accepted (<%= accepted.length %>)
</h2>
<% if (!accepted.length) { %>
    <div class="muted" style="padding:16px 0">Not writing anything right now.</div>
<% } else { %>
    <% accepted.forEach(function(task) { %>
        <a href="/tasks/<%= task._id %>" class="taskcard">
            <div class="row row--between">
                <div style="font-weight:700"><%= task.subject %></div>
                <%- include("../includes/components/statuspill.ejs", { status: task.status }) %>
            </div>
            <div class="muted" style="font-size:13px; margin-top:4px">
                ₹<%= task.price %> · for <%= task.author.name %>
            </div>
        </a>
    <% }); %>
<% } %>
