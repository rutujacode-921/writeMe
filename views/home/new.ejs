<% layout("/layouts/boilerplate") %>
<%
    const v = values || {};
%>

<a href="/" class="muted" style="font-size:14px">← Back</a>
<h1 style="font-size:22px; font-weight:700; margin:8px 0 24px">Post a new task</h1>

<% if (errors && errors.length) { %>
    <div style="background:rgba(231,76,60,0.1); color:var(--color-danger); padding:12px; border-radius:12px; margin-bottom:16px">
        <% errors.forEach(function(e) { %>
            <div><%= e.msg %><% if (e.path) { %> (<%= e.path %>)<% } %></div>
        <% }); %>
    </div>
<% } %>

<form method="POST" action="/tasks">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

    <div class="form-group">
        <label class="form-label" for="subject">Subject</label>
        <input class="form-input" type="text" name="data[subject]" id="subject"
               value="<%= v.subject || '' %>"
               placeholder="e.g. Chemistry Record Book" required />
    </div>

    <div class="form-group">
        <label class="form-label">Page range</label>
        <div class="form-row">
            <input class="form-input" type="number" min="1" name="data[pagesMin]"
                   value="<%= v.pagesMin || '' %>" placeholder="From" required />
            <input class="form-input" type="number" min="1" name="data[pagesMax]"
                   value="<%= v.pagesMax || '' %>" placeholder="To" required />
        </div>
    </div>

    <div class="form-group">
        <label class="form-label" for="price">Price (₹)</label>
        <div class="form-row">
            <input class="form-input" type="number" min="1" name="data[price]" id="price"
                   value="<%= v.price || '' %>" placeholder="250" required />
            <select class="form-select" name="data[priceType]">
                <option value="fixed" <%= v.priceType === 'fixed' ? 'selected' : '' %>>Fixed</option>
                <option value="negotiable" <%= v.priceType === 'negotiable' ? 'selected' : '' %>>Negotiable</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label class="form-label" for="deadline">Deadline</label>
        <input class="form-input" type="date" name="data[deadline]" id="deadline"
               value="<%= v.deadline || '' %>" required />
    </div>

    <div class="form-group">
        <label class="form-label" for="pickupPoint">Pickup point</label>
        <input class="form-input" type="text" name="data[pickupPoint]" id="pickupPoint"
               value="<%= v.pickupPoint || (currentUser && currentUser.defaultPickup) || '' %>"
               placeholder="e.g. Main Library" required />
        <div class="form-help">Choose a public campus spot. Avoid hostels/rooms.</div>
    </div>

    <button type="submit" class="btn btn--primary btn--block">Post Task</button>
</form>
